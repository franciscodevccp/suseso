    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
