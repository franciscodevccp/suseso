# Plantilla de configuración (docs/02). Copiar a `.env` y completar.
# Todas las variables son obligatorias: el servidor aborta si falta una.
# El `.env` real NUNCA se sube al repositorio (docs/14).

DATABASE_URL=postgresql://sisga:CAMBIAR@localhost:5432/sisga
# 64 caracteres hex aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CAMBIAR
# Clave única de las 4 cuentas de demostración (T-03, se rota tras la adjudicación)
CLAVE_DEMO=CAMBIAR
# Token de la API pública /api/v1 (T-03)
API_DEMO_KEY=CAMBIAR
# Ticket de la API pública de Mercado Público (T-02)
MP_API_TICKET=CAMBIAR
PUERTO=3001
ORIGEN_PERMITIDO=http://localhost:5173
STORAGE_DIR=./storage
